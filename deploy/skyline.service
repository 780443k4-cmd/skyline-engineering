[Unit]
Description=SKYLINE Engineering Next.js website
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/skyline-engineering
Environment=NODE_ENV=production
EnvironmentFile=/var/www/skyline-engineering/.env.production
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
